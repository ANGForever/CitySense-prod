# ─────────────────────────────────────────────────────────────
# 青唐冰雪节 · 环境变量
#
# 安全约定：模型凭据仅在服务端；高德 JS 配置经 /api/snow/config 下发。
# 当前 Demo 的 securityJsCode 会到浏览器，需配置高德域名白名单与配额保护。
# 不存在 /api/snow/amap 代理；正式部署前重新评估安全代理方案。
# ─────────────────────────────────────────────────────────────

# ── 高德地图 ──
# Web 服务 Key：服务端 REST 调用（地理编码、POI 等）。本项目暂时用不到，留作扩展。
AMAP_API_KEY=""
# JS API Key（Web端-JS API）：经 /api/snow/config 下发给浏览器，靠域名白名单保护。
# 注意：JS API Key 不能用于 Web 服务 REST 接口，会返回 USERKEY_PLAT_NOMATCH。
AMAP_JS_API_KEY=""
# JS API 安全密钥：经 /api/snow/config 下发，由 SDK 在浏览器侧使用。
# 走接口而不是 NEXT_PUBLIC_*，好处是不进构建产物、换密钥不用重新构建。
# 详见 app/api/snow/config/route.ts 顶部的取舍说明。
AMAP_SECURITY_JS_CODE=""

# ── 大模型 ──
# 任何 OpenAI 兼容端点均可，换 CHAT_LLM_BASE_URL 即可（下面是火山引擎方舟示例）。
#
# 凭据请写 SNOW_LLM_API_KEY，不要依赖 OPENAI_API_KEY：
# 真实环境变量优先于 .env 文件，而 OPENAI_API_KEY 常被其他工具在 User 级设过，
# 结果是 .env 里写对了也照样 401 —— 这个坑已经踩过一次。
SNOW_LLM_API_KEY=""
# 兼容旧脚本；仅在 SNOW_LLM_API_KEY 未设置时生效。
OPENAI_API_KEY=""
# 优先 CHAT_LLM_BASE_URL，其次 OPENAI_BASE_URL / OPENAI_API_BASE / API_BASE
CHAT_LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
CHAT_LLM_MODEL="deepseek-v4-1-flash-261017"
# 单次对话总超时（含工具轮），毫秒
SNOW_CHAT_TIMEOUT_MS="25000"

# ── 对话会话 ──
# 当前使用有界进程内存：TTL 24 小时、最多 10 轮。重启清空。
# 本轮未连接 Redis；多实例部署需要接入共享历史和共享限流。
# 单浏览器 8 次/分钟、全进程 60 次/分钟、500 次/滚动 24 小时。
REDIS_URL=""

# ── 对话接口的跨域白名单 ──
# /api/snow/chat 默认只接受同源请求（Origin 与 request.url 的 origin 一致）。
# 反向代理若改写了 Host，Next 推导出的 origin 会与浏览器实际来源不一致，
# 此时把公开域名写在这里（英文逗号分隔，含协议、不带结尾斜杠）。
# 不要指望用 X-Forwarded-Host 绕过：那是客户端可伪造的头。
SNOW_ALLOWED_ORIGINS=""

# ── 官方媒体账号（可公开信息，不是凭据） ──
# 视频号 finderUserName。填写后 bootstrap.social.channelsEnabled 才为 true；
# 但「已配置」不等于 G4 通过，主体关联与真机跳转仍需单独验收。
CHANNELS_FINDER_USER_NAME=""
# 抖音官方账号名称。仅用于信息展示，不实现从微信强制唤起抖音 App。
DOUYIN_ACCOUNT_NAME=""

# ── 小程序侧（在 mp/ 工程里配置，不在此文件） ──
# TARO_APP_API_BASE   = https://<主域名>          request 合法域名
# TARO_APP_H5_BASE    = https://<主域名>          web-view 业务域名
# TARO_APP_ID         = wx...                     真实 AppID（写进 mp/project.config.json）
